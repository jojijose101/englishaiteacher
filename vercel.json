{
  "builds": [
    {
      "src": "backend/speaksmart/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/speaksmart/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "backend/speaksmart/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ]
}
